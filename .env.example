# 九章WEB应用智能防护系统V2.0 环境变量示例
# 复制为 .env 后按实际环境修改
# 注意：.env 不得提交到 Git

# 环境标识：dev / staging / test / prod
# prod 触发严格安全校验（强制 COOKIE_SECURE 等）；test 供独立测试工程的安全门禁识别
# （经 X-Jiuzhang-Environment 响应头与 GET /api/v1/health 的 environment 字段外发，P-T1）
APP_ENV=dev

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jiuzhang_waf
POSTGRES_USER=jiuzhang
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Valkey（兼容 Redis 协议的键值存储，BSD-3-Clause）
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGE_ME_STRONG_PASSWORD
VALKEY_DB=0

# 管理服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
# 仅升级包上传请求使用的读写期限；不改变其他接口的30秒默认限制
UPGRADE_UPLOAD_TIMEOUT=10m

# 会话与安全
# 仅 HTTPS 下发 Cookie；prod 环境必须为 true（为 false 时服务拒绝启动）
COOKIE_SECURE=false
# 允许跨域来源（逗号分隔；开发环境留空时允许 vite dev server）
CORS_ALLOWED_ORIGINS=
# 管理面可信反向代理网段（逗号分隔 CIDR；仅来自这些网段的转发头会被解析）
MANAGEMENT_TRUSTED_PROXY_CIDRS=
# 主密钥（AES-256-GCM，加密 TOTP 密钥/证书私钥/备份等敏感数据）：64 位 hex（32 字节），
# 生产环境必填（缺失时服务拒绝启动）；开发环境缺省使用临时密钥（重启后旧密文不可解密）。
# 生成：ops 安装脚本自动生成，或执行 openssl rand -hex 32
JIUZHANG_MASTER_KEY=CHANGE_ME_64_HEX_CHARS

# Caddy
CADDY_ADMIN_SOCKET=/var/run/caddy/admin.sock
CADDY_CONFIG_PATH=/etc/caddy/Caddyfile

# 日志
LOG_LEVEL=info
LOG_FORMAT=json

# 服务发布端口（docker compose 对外映射；仅离线包/compose 部署使用）
# API_PORT 管理 API（仅 127.0.0.1）；WEB_PORT 管理控制台（web 容器，默认全接口供内网管理员访问）
API_PORT=18081
WEB_PORT=8080

# 产品形态：waf=纯WAF；wdsp=WAF+API动态防护；api=API安全系统（无Web防护专属菜单）
PRODUCT_EDITION=waf
# API 动态防护总开关；缺省时 waf=false、wdsp/api=true。WAF 包务必保持 false
API_DYNAMIC_PROTECTION_ENABLED=false
# Web 防护专属交付（策略/CC/访问控制菜单）；缺省时 api=false，其余 true
WEB_WAF_ENABLED=true
# APM 业务性能监控（无 Agent 模式）总开关；默认关闭，关闭时 /api/v1/apm/* 统一返回 503 降级。
# 此项仅为兜底：界面「系统设置 → APM 性能监控」配置后界面值优先且立即生效（无需重启）
APM_ENABLED=false
# APM 阶段2 下半 ClickHouse 数据面连接串；默认空 = 未接入，trace 检索降级为 agentless 空数据（不 500）。
# 此项仅为兜底：界面设置优先（不回显原文），界面值保存后立即重建连接
APM_CLICKHOUSE_DSN=
# 网关侧 API 防护模式：OFF | OBSERVE | PROTECT（缺省 OBSERVE）
API_PROTECTION_MODE=OBSERVE

# ---------- 离线授权（产品侧门控，详见 docs/LICENSE_DESIGN.md）----------
# 厂商验签公钥随正式构建内嵌（server/internal/license/vendor_pubkey.hex），运行时不接受覆盖；
# 未配置任何有效内嵌公钥时所有授权验签失败（fail-closed，系统进入锁定态）。
# 宿主机指纹文件（api 容器内路径）：安装期由 ops/install/install.sh 调用
# ops/lib/fingerprint.sh 采集并写入 <安装根>/runtime/license/host_fingerprint，
# compose 以只读挂载映射到容器内此路径；授权未绑定指纹时本文件不参与校验。
LICENSE_HOST_FINGERPRINT_FILE=/app/runtime/license/host_fingerprint

# API 运行时事件日志（管理面采集路径 / 网关容器内路径）
WAF_API_EVENTS_LOG=runtime/logs/api-runtime-events.log
GATEWAY_API_EVENTS_LOG=/var/log/caddy/api-runtime-events.log
# client_identity 身份与行为事件日志（管理面采集路径 / 网关容器内路径；
# WAF_IDENTITY_EVENTS_LOG 留空 = 不启动该采集器）
WAF_IDENTITY_EVENTS_LOG=runtime/logs/identity-events.log
GATEWAY_IDENTITY_EVENTS_LOG=/var/log/caddy/identity-events.log
# 执行覆盖观测日志（NG-COV-01 摄入段；管理面采集路径 / 网关容器内路径，默认同值——
# 同一 /var/log/caddy 卷内文件；观测文件未生成时采集器空转。WAF_COVERAGE_SAMPLE_N
# 为明细采样率 1/N，默认 10，聚合不受影响）
WAF_COVERAGE_OBS_LOG=runtime/logs/coverage-observations.jsonl
GATEWAY_COVERAGE_OBS_LOG=/var/log/caddy/coverage-observations.jsonl
WAF_COVERAGE_SAMPLE_N=10
# 站点资产发现记录日志（管理面采集路径；网关侧路径由 mirrorcap sidecar 下发）
WAF_SITE_DISCOVERY_LOG=runtime/logs/site-discovery.jsonl
# 采集器批量/周期 flush 阈值（W20 批量化修复；作用于 API 运行时事件与全量访问日志采集器）
WAF_COLLECTOR_FLUSH_BATCH=2000
WAF_COLLECTOR_FLUSH_INTERVAL=2s
# 边车配置共享卷目录（api 容器内路径，与网关容器共享；mirrorcap/tproxyd 等边车配置与
# network-status.json 均在此目录）
GATEWAY_SIDECAR_DIR=/var/run/caddy/sidecars
API_MAX_BODY_PARSE_BYTES=1048576
API_MAX_BODY_SAMPLE_BYTES=65536
API_MAX_JSON_DEPTH=32
API_MAX_FIELD_COUNT=2048
