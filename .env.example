# 九章WEB应用智能防护系统V2.0 环境变量示例
# 复制为 .env 后按实际环境修改
# 注意：.env 不得提交到 Git

# 环境标识：dev / staging / prod
APP_ENV=dev

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jiuzhang_waf
POSTGRES_USER=jiuzhang
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Valkey（兼容 Redis 协议的键值存储，BSD-3-Clause）
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=CHANGE_ME_STRONG_PASSWORD
VALKEY_DB=0

# 管理服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# 会话与安全
SESSION_SECRET=CHANGE_ME_32_BYTES_RANDOM_SECRET
CSRF_SECRET=CHANGE_ME_32_BYTES_RANDOM_SECRET
PASSWORD_HASH_ALGORITHM=argon2id

# Caddy
CADDY_ADMIN_SOCKET=/var/run/caddy/admin.sock
CADDY_CONFIG_PATH=/etc/caddy/Caddyfile

# 日志
LOG_LEVEL=info
LOG_FORMAT=json
