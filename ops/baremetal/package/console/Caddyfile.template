# 九章 WDSP 管理控制台（裸机）—— Caddyfile 模板（双栈：HTTP + HTTPS）
# install.sh 渲染为 <安装根>/console/Caddyfile，占位符：
#   __ROOT__           安装根（默认 /opt/jiuzhang-wdsp）
#   __WEB_PORT__       HTTP 端口（env 的 WEB_PORT，默认 8080）
#   __WEB_HTTPS_PORT__ HTTPS 端口（env 的 WEB_HTTPS_PORT，默认 8443）
# 证书两文件齐备时使用本模板；缺失时 install.sh 改用 Caddyfile.http-only.template。
# 安全响应头 / CSP 与 web/Caddyfile.docker 的 (site) snippet 保持一致。

{
	# 控制台 Caddy 不接入 Admin API（也不带 --resume，与网关 autosave 体系隔离）
	admin off
	# 双栈刻意保留 HTTP 入口，禁用 Caddy 自动 HTTP→HTTPS 重定向
	auto_https disable_redirects
}

(site) {
	root * __ROOT__/web

	# 安全响应头
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		Cache-Control "no-store"
		-Server
	}

	# API 反向代理到管理后端（仅回环监听，见 env 的 SERVER_HOST/SERVER_PORT）
	handle /api/* {
		reverse_proxy 127.0.0.1:18081
	}

	# 静态资源（带缓存指纹的 assets 长缓存；mmdb 等大文件支持预压缩 gzip）
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed gzip
		}
	}

	# SPA 路由回退到 index.html
	handle {
		try_files {path} /index.html
		file_server
	}
}

:__WEB_PORT__ {
	import site
}

:__WEB_HTTPS_PORT__ {
	tls __ROOT__/certificates/console.crt __ROOT__/certificates/console.key
	import site
}
