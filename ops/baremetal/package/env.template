# 九章 WEB 应用智能防护系统（WDSP）裸机版运行环境文件
# 由 install.sh 渲染生成 <安装根>/env（0640 root:jiuzhang），重装时保留并仅补缺失键。
# 占位符（__XXX__）由 install.sh 替换；口令类为安装期随机生成，请勿外泄。

# ---- 产品形态 ----
APP_ENV=prod
PRODUCT_EDITION=wdsp
API_DYNAMIC_PROTECTION_ENABLED=true
WEB_WAF_ENABLED=true
API_PROTECTION_MODE=OBSERVE
APM_ENABLED=false

# ---- 管理后端 API（让开控制台端口，仅监听回环，由控制台 Caddy 反代 /api） ----
SERVER_HOST=127.0.0.1
SERVER_PORT=18081

# ---- PostgreSQL（裸机内置实例） ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jiuzhang_waf
POSTGRES_USER=jiuzhang
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# ---- Valkey（裸机内置实例） ----
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=__VALKEY_PASSWORD__
GATEWAY_VALKEY_ADDR=127.0.0.1:6379

# ---- 安全基线 ----
COOKIE_SECURE=true
GUARD_FAIL_OPEN=false
JIUZHANG_MASTER_KEY=__MASTER_KEY__

# ---- 网关对接 ----
CADDY_ADMIN_SOCKET=__ROOT__/data/run/caddy/admin.sock
GATEWAY_DATA_DIR=__ROOT__/data/runtime
GATEWAY_SIDECAR_DIR=__ROOT__/data/run/caddy/sidecars
GATEWAY_NODE_NAME=gateway-baremetal-01

# ---- 资源路径 ----
MIGRATIONS_DIR=__ROOT__/migrations
LICENSE_HOST_FINGERPRINT_FILE=__ROOT__/data/runtime/license/host_fingerprint
WAF_CRS_DIR=__ROOT__/gateway/rules/crs/rules
REPORT_FONT_PATH=__ROOT__/assets/fonts/NotoSansCJKsc-VF.ttf
HOSTCTL_DIR=__ROOT__/data/runtime/hostctl

# ---- 网关日志（api 侧读取路径与下发网关侧路径一致，均落 <安装根>/data/logs/caddy/） ----
WAF_AUDIT_LOG=__ROOT__/data/logs/caddy/coraza-audit.log
WAF_ACCESS_LOG=__ROOT__/data/logs/caddy/access.log
WAF_GUARD_EVENTS_LOG=__ROOT__/data/logs/caddy/guard-events.log
GATEWAY_GUARD_EVENTS_LOG=__ROOT__/data/logs/caddy/guard-events.log
WAF_API_EVENTS_LOG=__ROOT__/data/logs/caddy/api-runtime-events.log
GATEWAY_API_EVENTS_LOG=__ROOT__/data/logs/caddy/api-runtime-events.log
WAF_ACCESS_FULL_LOG=__ROOT__/data/logs/caddy/access-full.jsonl
GATEWAY_ACCESS_FULL_LOG=__ROOT__/data/logs/caddy/access-full.jsonl
WAF_NODE_IFACES_LOG=__ROOT__/data/logs/caddy/node-interfaces.jsonl
WAF_SITE_DISCOVERY_LOG=__ROOT__/data/logs/caddy/site-discovery.jsonl

# ---- 初始管理员（仅首次启动、库中无任何用户时生效；登录后强制改密） ----
INITIAL_ADMIN_USERNAME=jiuzhang_admin
# 初始化完成后请删除下一行并重启 jiuzhang-api（systemctl restart jiuzhang-api）
INITIAL_ADMIN_PASSWORD=__INITIAL_ADMIN_PASSWORD__

# ---- 控制台监听端口（仅供 install.sh 渲染 console/Caddyfile，api 不读取） ----
WEB_PORT=8080
WEB_HTTPS_PORT=8443
