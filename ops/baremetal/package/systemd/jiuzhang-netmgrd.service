# 九章 WDSP 网络配置 sidecar netmgrd（裸机）
# __ROOT__/__USER__/__NODE_NAME__ 由 install.sh 渲染替换后安装到 /etc/systemd/system/
[Unit]
Description=JiuZhang WDSP netmgrd (network config sidecar, baremetal)
After=network-online.target jiuzhang-api.service
Wants=network-online.target

[Service]
Type=simple
# 例外：netmgrd 以 root 运行——需 NET_ADMIN/NET_RAW 改网口、写 /etc/resolv.conf 与
# timesyncd/chronyd 配置；仍通过 NoNewPrivileges=yes 与 CapabilityBoundingSet
# 严格收敛能力集至 CAP_NET_ADMIN CAP_NET_RAW。
User=root
Group=root
SupplementaryGroups=__USER__
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ExecStart=__ROOT__/bin/netmgrd --config __ROOT__/data/run/caddy/sidecars/network.json --status __ROOT__/data/run/caddy/sidecars/network-status.json --node __NODE_NAME__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
