# 九章管理前端托管配置（生产容器）
# 静态文件托管 + SPA 路由回退 + /api 反向代理到管理后端
# HTTP :8080 与 HTTPS :8443 双栈服务；HTTPS 证书由宿主机安装期生成
# （ops/install/console-cert.sh，自签、100 年有效期），只读挂载到
# /etc/caddy/console-certs/。证书缺失时入口脚本改用 Caddyfile.http-only。

{
	# 双栈刻意保留 HTTP 入口，禁用 Caddy 自动 HTTP→HTTPS 重定向
	auto_https disable_redirects
}

(site) {
	root * /usr/share/caddy

	# 安全响应头
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		Cache-Control "no-store"
		-Server
	}

	# API 反向代理到管理后端
	handle /api/* {
		reverse_proxy api:8080
	}

	# 静态资源（带缓存指纹的 assets 长缓存；mmdb 等大文件支持预压缩 gzip）
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed gzip
		}
	}

	# SPA 路由回退到 index.html
	handle {
		try_files {path} /index.html
		file_server
	}
}

:8080 {
	import site
}

:8443 {
	tls /etc/caddy/console-certs/console.crt /etc/caddy/console-certs/console.key
	import site
}
